---
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, type CollectionEntry } from "astro:content"

type Props = { ctf: CollectionEntry<"ctfs"> }

const { ctf } = Astro.props
const { title, event, category, difficulty, placement, tags } = ctf.data
const authors = await getEntries(ctf.data.authors)
---

<li>
  {ctf.data.image && (
      <a href={`/ctfs/${ctf.id}`} tabindex="-1" aria-hidden="true">
        <Image src={ctf.data.image} alt="" width={640} height={336} />
      </a>
    )}
  <entry-info>
    <a href={`/ctfs/${ctf.id}`}>{title}</a>
    <entry-meta>
      {authors.length > 0 && (
          <entry-authors>
            <author-avatars>
              {authors.map((author) => (
                <img
                  src={author.data.avatar}
                  alt={author.data.name}
                  width="18"
                  height="18"
                />
              ))}
            </author-avatars>
            <author-names>
              {authors.map((author, i) => (
                <>{i > 0 && ", "}{author.data.name}</>
              ))}
            </author-names>
          </entry-authors>
        )}
      <time datetime={ctf.data.date.toISOString()}>{formatDate(ctf.data.date)}</time>
      <entry-event>{event}</entry-event>
    </entry-meta>
    <entry-badges>
      <span>{category}</span>
      {difficulty && <span>{difficulty}</span>}
      {placement && <span data-placement>{placement}</span>}
    </entry-badges>
    <p>{ctf.data.description}</p>
    {tags && tags.length > 0 && (
        <entry-tags>
          {tags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </entry-tags>
      )}
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 14rem;

      :global(img) {
        inline-size: 100%;
        block-size: auto;
      }
    }

    entry-info {
      display: flex;
      flex-direction: column;

      > a {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-end: var(--space-2xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        entry-authors {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);

          author-avatars {
            display: flex;
            margin-block-end: -0.1em;

            img {
              border-radius: var(--radius-full);
              box-shadow: 0 0 0 1.5px var(--background);

              &:not(:first-child) {
                margin-inline-start: -0.375rem;
              }
            }
          }
        }

        entry-authors ~ time::before {
          content: "·";
          margin-inline-end: var(--space-3xs);
        }

        time ~ entry-event::before {
          content: "·";
          margin-inline-end: var(--space-3xs);
        }
      }

      entry-badges {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        margin-block-end: var(--space-2xs);
        font-size: var(--step--1);

        span {
          padding-inline: var(--space-2xs);
          color: var(--muted-foreground);
          background-color: color-mix(in oklab, var(--muted) 50%, transparent);
          border-radius: var(--radius-full);
          text-transform: capitalize;

          &[data-placement] {
            color: var(--foreground);
          }
        }
      }

      p {
        color: var(--muted-foreground);
      }

      entry-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        margin-block-start: var(--space-2xs);

        span {
          color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);
        }
      }
    }

    @media (width < 40rem) {
      flex-direction: column;

      > a {
        inline-size: 100%;
        max-inline-size: 32rem;
      }
    }
  }
</style>
