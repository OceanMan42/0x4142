---
import CaptureStepper from "@/components/CaptureStepper.astro"
import MetaPost from "@/components/MetaPost.astro"
import PostActions from "@/components/PostActions.astro"
import ReadingProgress from "@/components/ReadingProgress.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import SeriesNav from "@/components/SeriesNav.astro"
import SeriesParts from "@/components/SeriesParts.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import { getBlogEntries, getFeed, readingTime } from "@/lib/content"
import {
  partsOf,
  seriesNav,
  type Part,
  type SeriesNav as Nav,
} from "@/lib/series"
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, render, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const entries = await getBlogEntries()
  const items = await getFeed()
  const posts = items.filter(({ series }) => !series).map(({ post }) => post)
  return items.map(({ post }) => {
    const nav = seriesNav(entries, post.id)
    const i = posts.indexOf(post)
    return {
      params: { id: post.id },
      props: {
        post,
        nav,
        parts: nav ? [] : partsOf(entries, post.id),
        prev: nav ? nav.prev : posts[i + 1],
        next: nav ? nav.next : posts[i - 1],
      },
    }
  })
}

type Post = CollectionEntry<"blog">
type Props = {
  post: Post
  nav?: Nav<Post>
  parts: Part<Post>[]
  prev?: Post
  next?: Post
}

const { post, nav, parts, prev, next } = Astro.props
const { Content, headings } = await render(post)
const authors = await getEntries(post.data.authors)
const minutes = readingTime(post.body ?? "")

const tocHeadings = headings.filter(
  ({ depth, text }) => depth >= 2 && depth <= 4 && text.trim(),
)

const crumbs = nav
  ? [
      { label: nav.parent.data.title, href: `/blog/${nav.parent.id}` },
      { label: post.data.title, href: `/blog/${post.id}` },
    ]
  : [{ label: post.data.title, href: `/blog/${post.id}` }]
---

<Layout crumbs={crumbs}>
  <MetaPost slot="head" post={post} />
  {tocHeadings.length > 0 && (
      <TableOfContents
        slot="toc"
        title={post.data.title}
        sections={[{ label: post.data.title, headings: tocHeadings }]}
      />
    )}
  <PostActions slot="actions" prev={prev} next={next} />
  <ReadingProgress />
  <ScrollToTop floating />
  <CaptureStepper />
  <article>
    <header>
      {nav && (
            <series-label>
              <a href={`/blog/${nav.parent.id}`}>{nav.parent.data.title}</a>
              <span>Part {nav.number}</span>
            </series-label>
          )}
      <h1>{post.data.title}</h1>
      <post-meta>
        {authors.length > 0 && (
              <post-authors>
                <author-avatars>
                  {authors.map((author) => (
                    <img
                      src={author.data.avatar}
                      alt={author.data.name}
                      width="18"
                      height="18"
                    />
                  ))}
                </author-avatars>
                <author-names>
                  {authors.map((author, j) => (
                    <>{j > 0 && ", "}<a href={`/authors/${author.id}`}>{author.data.name}</a></>
                  ))}
                </author-names>
              </post-authors>
            )}
        <time datetime={post.data.date.toISOString()}
          >{formatDate(post.data.date)}</time
        >
        <read-time>{minutes} min read</read-time>
        {post.data.tags && (
              <post-tags>
                {post.data.tags.map((tag) => (
                  <a href={`/tags/${tag}`}>#{tag}</a>
                ))}
              </post-tags>
            )}
      </post-meta>
      <p>{post.data.description}</p>
    </header>
    {post.data.image && (
          <post-banner>
            <Image
              src={post.data.image}
              alt={post.data.title}
              width={1200}
              height={630}
              priority
            />
          </post-banner>
        )}
    <prose-content>
      <Content />
    </prose-content>
    {parts.length > 0 && <SeriesParts parts={parts} />}
    {nav && <SeriesNav nav={nav} />}
  </article>
</Layout>

<style>
  header {
    margin-block-end: var(--space-m);

    series-label {
      display: flex;
      gap: var(--space-3xs);
      margin-block-end: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      span::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }
    }

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    post-meta {
      --underline: var(--muted-foreground);

      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3xs);
      margin-block-start: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      post-authors {
        display: flex;
        align-items: center;
        gap: var(--space-3xs);

        author-avatars {
          display: flex;
          margin-block-end: -0.1em;

          img {
            border-radius: var(--radius-full);
            box-shadow: 0 0 0 1.5px var(--background);

            &:not(:first-child) {
              margin-inline-start: -0.375rem;
            }
          }
        }
      }

      post-authors ~ time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }

      time ~ read-time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }

      post-tags {
        --underline: transparent;

        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);

        a {
          color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);

          &:hover {
            color: var(--foreground);
          }
        }
      }

      time ~ post-tags::before {
        content: "·";
      }

      a {
        color: var(--foreground);
      }
    }

    > p {
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  post-banner {
    display: block;
    margin-block-end: var(--space-m);

    :global(img) {
      inline-size: 100%;
      block-size: auto;
    }
  }
</style>
