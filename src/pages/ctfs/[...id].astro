---
import CTFActions from "@/components/CTFActions.astro"
import MetaCTF from "@/components/MetaCTF.astro"
import ReadingProgress from "@/components/ReadingProgress.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import { getCTFs, pageTitle, readingTime } from "@/lib/content"
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, render, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const writeups = await getCTFs()
  return writeups.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: writeups[i + 1], next: writeups[i - 1] },
  }))
}

type Props = {
  entry: CollectionEntry<"ctfs">
  prev?: CollectionEntry<"ctfs">
  next?: CollectionEntry<"ctfs">
}

const { entry, prev, next } = Astro.props
const { Content, headings } = await render(entry)
const authors = await getEntries(entry.data.authors)
const minutes = readingTime(entry.body ?? "")
const { title, event, category, difficulty, placement } = entry.data

const sections = [
  {
    id: undefined,
    label: title,
    open: true,
    headings: headings.filter(
      ({ depth, text }) => depth >= 2 && depth <= 4 && text.trim(),
    ),
  },
]
const hasToc = sections.some(({ headings }) => headings.length > 0)
---

<Layout crumbs={[{ label: "CTFs", href: "/ctfs" }]}>
  <MetaCTF slot="head" entry={entry} />
  {hasToc && (
      <TableOfContents slot="toc" title={title} sections={sections} />
    )}
  <CTFActions slot="actions" prev={prev} next={next} />
  <ReadingProgress />
  <ScrollToTop floating />
  <article data-url={`/ctfs/${entry.id}`} data-title={pageTitle(title)}>
    <header>
      <h1>{title}</h1>
      <post-meta>
        {authors.length > 0 && (
            <post-authors>
              <author-avatars>
                {authors.map((author) => (
                  <img
                    src={author.data.avatar}
                    alt={author.data.name}
                    width="18"
                    height="18"
                  />
                ))}
              </author-avatars>
              <author-names>
                {authors.map((author, j) => (
                  <>{j > 0 && ", "}<a href={`/authors/${author.id}`}>{author.data.name}</a></>
                ))}
              </author-names>
            </post-authors>
          )}
        <time datetime={entry.data.date.toISOString()}
          >{formatDate(entry.data.date)}</time
        >
        <read-time>{minutes} min read</read-time>
        {entry.data.tags && (
            <post-tags>
              {entry.data.tags.map((tag) => <span>#{tag}</span>)}
            </post-tags>
          )}
      </post-meta>
      <ctf-facts>
        <span>{event}</span>
        <span>{category}</span>
        {difficulty && <span>{difficulty}</span>}
        {placement && <span data-placement>{placement}</span>}
      </ctf-facts>
      <p>{entry.data.description}</p>
    </header>
    {entry.data.image && (
        <post-banner>
          <Image
            src={entry.data.image}
            alt={title}
            width={1200}
            height={630}
            priority
          />
        </post-banner>
      )}
    <prose-content>
      <Content />
    </prose-content>
  </article>
</Layout>

<style>
  header {
    margin-block-end: var(--space-m);

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    post-meta {
      --underline: var(--muted-foreground);

      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3xs);
      margin-block-start: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      post-authors {
        display: flex;
        align-items: center;
        gap: var(--space-3xs);

        author-avatars {
          display: flex;
          margin-block-end: -0.1em;

          img {
            border-radius: var(--radius-full);
            box-shadow: 0 0 0 1.5px var(--background);

            &:not(:first-child) {
              margin-inline-start: -0.375rem;
            }
          }
        }
      }

      post-authors ~ time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }

      time ~ read-time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }

      post-tags {
        --underline: transparent;

        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);

        span {
          color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);
        }
      }

      read-time ~ post-tags::before {
        content: "·";
      }

      a {
        color: var(--foreground);
      }
    }

    ctf-facts {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3xs);
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);

      span {
        padding-inline: var(--space-2xs);
        color: var(--muted-foreground);
        background-color: color-mix(in oklab, var(--muted) 50%, transparent);
        border-radius: var(--radius-full);
        text-transform: capitalize;

        &[data-placement] {
          color: var(--foreground);
        }
      }
    }

    > p {
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  post-banner {
    display: block;
    margin-block-end: var(--space-m);

    :global(img) {
      inline-size: 100%;
      block-size: auto;
    }
  }
</style>
