---
import BlogCard from "@/components/BlogCard.astro"
import CTFCard from "@/components/CTFCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import SeriesPanel from "@/components/SeriesPanel.astro"
import SocialIcons from "@/components/SocialIcons.astro"
import Layout from "@/layouts/Layout.astro"
import { SITE, SOCIALS } from "@/consts"
import { getCTFs, getFeed, getProjects, getSeries } from "@/lib/content"

const series = await getSeries()
const recentPosts = (await getFeed()).slice(0, 5)
const writeups = (await getCTFs()).slice(0, 3)
const projects = (await getProjects()).slice(0, 3)
---

<Layout>
  <MetaPage slot="head" />
  <home-intro>
    <h1>{SITE.title}</h1>
    {SITE.tagline && <p data-tagline>{SITE.tagline}</p>}
    <p>
      I reverse engineer binaries, play CTFs, and write up what I learn along
      the way, from how a compiler lays out <code>main</code> to how a stack
      frame gets smashed. The handle is my initials in hex:
      <code>0x41 0x42</code> is "AB" in ASCII.
    </p>
    <SocialIcons links={SOCIALS} />
  </home-intro>

  {series.length > 0 && (
      <home-section>
        <h2>Series</h2>
        {series.map((s) => <SeriesPanel series={s} />)}
      </home-section>
    )}

  {recentPosts.length > 0 && (
      <home-section>
        <h2>Recent posts</h2>
        <ul>
          {recentPosts.map((item) => <BlogCard {...item} />)}
        </ul>
        <a href="/blog" data-all>All posts →</a>
      </home-section>
    )}

  {writeups.length > 0 && (
      <home-section>
        <h2>CTF write-ups</h2>
        <ul>
          {writeups.map((ctf) => <CTFCard ctf={ctf} />)}
        </ul>
        <a href="/ctfs" data-all>All write-ups →</a>
      </home-section>
    )}

  {projects.length > 0 && (
      <home-section>
        <h2>Projects</h2>
        <ul>
          {projects.map((project) => <ProjectCard project={project} />)}
        </ul>
        <a href="/projects" data-all>All projects →</a>
      </home-section>
    )}
</Layout>

<style>
  home-intro {
    display: block;

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
    }

    [data-tagline] {
      margin-block-start: var(--space-3xs);
      color: var(--muted-foreground);
      font-size: var(--step-0);
    }

    > p:not([data-tagline]) {
      margin-block-start: var(--space-m);
      color: var(--muted-foreground);
    }

    :global(ul) {
      margin-block-start: var(--space-m);
    }
  }

  home-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);

    h2 {
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
    }

    [data-all] {
      align-self: flex-start;
      font-size: var(--step--1);
    }
  }
</style>
