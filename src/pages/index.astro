---
import BlogCard from "@/components/BlogCard.astro"
import CTFCard from "@/components/CTFCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import SeriesPanel from "@/components/SeriesPanel.astro"
import SocialIcons from "@/components/SocialIcons.astro"
import Layout from "@/layouts/Layout.astro"
import { SITE, SOCIALS } from "@/consts"
import { getCTFs, getFeed, getProjects, getSeries } from "@/lib/content"
import { getEntry, render } from "astro:content"

const owner = await getEntry("authors", SITE.author)
const Bio = owner?.body?.trim() ? (await render(owner)).Content : undefined

const series = await getSeries()
const recentPosts = (await getFeed()).slice(0, 5)
const writeups = (await getCTFs()).slice(0, 3)
const projects = (await getProjects()).slice(0, 3)
---

<Layout>
  <MetaPage slot="head" />
  <home-intro>
    <h1>{SITE.title}</h1>
    {SITE.tagline && <p data-tagline>{SITE.tagline}</p>}
    {Bio && (
        <home-bio>
          <Bio />
        </home-bio>
      )}
    <SocialIcons links={SOCIALS} />
  </home-intro>

  {series.length > 0 && (
      <home-section>
        <h2>Series</h2>
        {series.map((s) => <SeriesPanel series={s} />)}
      </home-section>
    )}

  {recentPosts.length > 0 && (
      <home-section>
        <h2>Recent posts</h2>
        <ul>
          {recentPosts.map((item) => <BlogCard {...item} />)}
        </ul>
        <a href="/blog" data-all>All posts →</a>
      </home-section>
    )}

  {writeups.length > 0 && (
      <home-section>
        <h2>CTF write-ups</h2>
        <ul>
          {writeups.map((ctf) => <CTFCard ctf={ctf} />)}
        </ul>
        <a href="/ctfs" data-all>All write-ups →</a>
      </home-section>
    )}

  {projects.length > 0 && (
      <home-section>
        <h2>Projects</h2>
        <ul>
          {projects.map((project) => <ProjectCard project={project} />)}
        </ul>
        <a href="/projects" data-all>All projects →</a>
      </home-section>
    )}
</Layout>

<style>
  home-intro {
    display: block;

    /* The sidebar already shows the name; keep the heading for screen
       readers and search engines only. */
    h1 {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    [data-tagline] {
      margin-block-start: var(--space-3xs);
      color: var(--muted-foreground);
      font-size: var(--step-0);
    }

    /* Rendered from the owner's author file, so the paragraphs carry no
       scoping attribute; style them through :global. */
    home-bio {
      display: block;
      color: var(--muted-foreground);

      :global(p + p) {
        margin-block-start: var(--space-s);
      }
    }

    [data-tagline] + home-bio {
      margin-block-start: var(--space-m);
    }

    :global(ul) {
      margin-block-start: var(--space-m);
    }
  }

  home-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);

    h2 {
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
    }

    [data-all] {
      align-self: flex-start;
      font-size: var(--step--1);
    }
  }
</style>
